// 咕咕 gugu — Revolt-style three-pane chat UI (Slint, software renderer)
// Layout: server rail | channel sidebar | chat (header + messages + input) | collapsible members.
// Animated stickers: Slint has no native gif (upstream #2081), so Rust decodes
// the frames once and publishes the current one through the `StickerAnim`
// global — rows pick it up by uid, and the message model is never rewritten
// per frame (rewriting a row dirtied its layout, and thus the whole pane).
// Palette refined from revite dark preset (revite/src/context/Theme.tsx), accent = blurple.

import { LineEdit, Button, ScrollView } from "std-widgets.slint";

// Near-black base, slightly lighter panels, blurple accent.
global Palette {
    out property <[color]> avatars: [
        #c0392b, #2980b9, #27ae60, #8e44ad,
        #f0932b, #d81b60, #16a085, #008b8b
    ];
    out property <color> rail: #101010;
    out property <color> side: #1e1e1e;
    out property <color> chat: #242424;
    out property <color> header: #2b2b2b;
    out property <color> input: #363636;
    out property <color> text: #f6f6f6;
    out property <color> text-secondary: #c8c8c8;
    out property <color> muted: #848484;
    out property <color> body: #dbdee1;
    out property <color> accent: #5865f2;
    out property <color> selected: #5865f226; // blurple @ ~15%
}
// Animated-sticker frame channel. One Rust timer owns the whole animation:
// each tick it publishes the row uid it advanced and that frame here. Rows
// compare `msg.uid` against `active-uid` to pick the live frame or their own
// static first frame. Keeping frames out of the message model is what stops
// the per-frame row rewrite that dirtied every row's layout (M2 stall).
export global StickerAnim {
    in property <int> active-uid: -1;   // -1 = no row animating
    in property <image> frame;
}

export struct Server {
    name: string,
    initial: string,   // first char uppercased, computed in Rust (no substring in slint)
    color: int,        // avatar palette index
}

export struct Channel {
    name: string,
    header: bool,      // section label row, not selectable
    peer_id: string,   // QQ id as string (i64 outlives slint's i32); "" = header/demo row
    is_group: bool,    // true → SendGroup, false → SendPrivate
    unread: int,       // pending message count; 0 = none
}

export struct Member {
    name: string,
    initial: string,
    color: int,
}

// Delivery state of an outgoing message row. `retrying` is reserved for a
// future per-attempt surface; v1 only ever displays sent/failed.
export enum SendStatus {
    sent,
    retrying,
    failed,
}

export struct Message {
    author: string,
    initial: string,
    body: string,
    time: string,
    color: int,
    sticker: image,    // empty image = no sticker; the animation swaps frames in place
    grouped: bool,     // continuation of same author's group: body-only row, indented
    uid: int,          // stable row id, assigned once on insert and never re-assigned
    client-id: int,    // == uid for outgoing rows; the send retry machinery echoes it back
    status: SendStatus,
}

// One grid cell of the sticker picker: precomputed first-frame thumbnail
// plus its (row, col) in the nine-grid — no division/math in .slint.
export struct StickerCell {
    image: image,
    pack: int,
    index: int,
    row: int,
    col: int,
}

// One chat message. Head row: avatar + name + time + body.
// Grouped row: no avatar/name, indented so bodies align with the head row's body.
component MessageRow inherits Rectangle {
    in property <Message> msg;
    in property <length> sticker-size: 120px;
    vertical-stretch: 0; // otherwise the scroll viewport stretches rows to fill it

    HorizontalLayout {
        padding-left: msg.grouped ? 54px : 12px; // 12 + avatar 34 + spacing 8
        padding-right: 12px;
        padding-top: msg.grouped ? 1px : 7px;
        padding-bottom: 3px;
        spacing: 8px;

        if !msg.grouped: Rectangle {
            width: 34px; height: 34px; border-radius: 17px;
            background: Palette.avatars[Math.mod(msg.color, 8)];
            Text {
                text: msg.initial;
                color: white; font-size: 16px; font-weight: 600;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: stretch; spacing: 2px;
            if !msg.grouped: HorizontalLayout {
                spacing: 6px; alignment: start;
                Text { text: msg.author; color: Palette.text; font-size: 13px; font-weight: 700; }
                Text { text: msg.time;  color: Palette.muted; font-size: 11px; }
            }
            Text {
                text: msg.body;
                color: Palette.body;
                font-size: 14px;
                wrap: word-wrap;
                width: 100%;
            }
            // Animated sticker slot. The element tree is static — no `if` on
            // msg.sticker — so the row's layout is computed once when the row
            // is pushed and the gif loop never re-dirties it: the timer only
            // rewrites the StickerAnim global, and this `source` binding then
            // changes pixels inside a cell whose size was fixed at insert.
            // An empty sticker image collapses the cell to 0px, so plain text
            // rows pay no space for the slot.
            Image {
                width: msg.sticker.width > 0 ? sticker-size : 0px;
                height: msg.sticker.width > 0 ? sticker-size : 0px;
                image-fit: contain;
                source: StickerAnim.active-uid == msg.uid ? StickerAnim.frame : msg.sticker;
            }
            // Send status: only surfaced when it isn't a plain success.
            // Transitions are one-shot (at most two per row's lifetime), so
            // an `if` here never feeds the per-frame redraw pump.
            if msg.status != SendStatus.sent: Text {
                text: msg.status == SendStatus.failed ? "发送失败" : "发送中…";
                color: msg.status == SendStatus.failed ? #e74c3c : Palette.muted;
                font-size: 11px;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "咕咕 gugu";
    preferred-width: 1000px;
    preferred-height: 700px;
    background: Palette.chat;

    in property <[Server]> servers;
    in property <[Channel]> channels;
    private property <int> selected-server: 0; // rail selection is view-only state
    in property <int> selected;
    in property <[Member]> members;
    in property <[Message]> messages;
    in-out property <string> draft: "";
    in-out property <bool> show-members: true;
    in-out property <bool> show-stickers: false;
    in property <[string]> pack-names;
    in property <[StickerCell]> sticker-cells;
    in property <length> grid-height;
    in-out property <int> current-pack: 0;
    in property <string> conn-label: "演示模式";
    callback send();
    callback select-channel(index: int);
    callback select-pack(index: int);
    callback pick-sticker(pack: int, index: int);

    HorizontalLayout {
        spacing: 0;

        // ---- server rail ----
        Rectangle {
            width: 56px;
            background: Palette.rail;
            VerticalLayout {
                padding-top: 10px; spacing: 8px;
                alignment: start;
                for srv[idx] in servers: Rectangle {
                    height: 44px;
                    TouchArea {
                        clicked => { root.selected-server = idx; }
                    }
                    // left blurple pill on the active server
                    if root.selected-server == idx: Rectangle {
                        x: 0px; y: 9px; width: 4px; height: 26px;
                        border-radius: 2px; background: Palette.accent;
                    }
                    Rectangle {
                        x: (parent.width - 44px) / 2;
                        width: 44px; height: 44px; border-radius: 22px;
                        background: Palette.avatars[Math.mod(srv.color, 8)];
                        border-width: root.selected-server == idx ? 2px : 0px;
                        border-color: Palette.text;
                        Text {
                            text: srv.initial;
                            color: white; font-size: 17px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ---- channel sidebar ----
        Rectangle {
            width: 200px;
            background: Palette.side;
            VerticalLayout { spacing: 0;
                Rectangle {
                    height: 48px;
                    // Title + connection status (Rust sets conn-label:
                    // 演示模式 / 已连接 / 已连接 · nickname).
                    VerticalLayout {
                        padding-left: 14px; padding-top: 7px; spacing: 1px;
                        Text {
                            text: "咕咕";
                            color: Palette.text; font-size: 15px; font-weight: 700;
                            horizontal-alignment: left;
                        }
                        HorizontalLayout {
                            spacing: 5px; alignment: start;
                            Rectangle {
                                width: 7px; height: 7px; border-radius: 4px;
                                background: root.conn-label == "演示模式" ? Palette.muted : #27ae60;
                            }
                            Text {
                                text: root.conn-label;
                                color: Palette.muted; font-size: 10px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                ScrollView {
                    VerticalLayout {
                        padding-left: 8px; padding-right: 8px; padding-bottom: 8px;
                        spacing: 2px; alignment: start;
                        for ch[idx] in channels: TouchArea {
                            height: 30px;
                            clicked => {
                                if !ch.header { root.select-channel(idx); }
                            }
                            Rectangle {
                                width: parent.width; height: parent.height;
                                border-radius: 4px;
                                background: root.selected == idx && !ch.header ? Palette.selected : transparent;
                                Text {
                                    text: ch.name;
                                    color: ch.header ? Palette.muted : (root.selected == idx ? white : Palette.text-secondary);
                                    font-size: ch.header ? 11px : 14px;
                                    font-weight: ch.header ? 700 : 600;
                                    vertical-alignment: center; x: 6px;
                                }
                                if ch.unread > 0: Rectangle {
                                    x: parent.width - 42px; y: 7px;
                                    width: 28px; height: 16px;
                                    border-radius: 8px;
                                    background: Palette.accent;
                                    Text {
                                        text: ch.unread > 99 ? "99+" : ch.unread;
                                        color: white; font-size: 10px; font-weight: 700;
                                        vertical-alignment: center; horizontal-alignment: center;
                                        width: 100%; height: 100%;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- main chat ----
        Rectangle {
            background: Palette.chat;
            VerticalLayout { spacing: 0;

                // header: channel title + member list toggle
                Rectangle {
                    height: 48px;
                    background: Palette.header;
                    Text {
                        text: channels[selected].name;
                        color: Palette.text; font-size: 15px; font-weight: 700;
                        vertical-alignment: center; y: 0px; height: 100%; x: 14px;
                    }
                    Button {
                        x: parent.width - self.width - 12px;
                        y: (parent.height - self.height) / 2;
                        width: 88px; height: 32px;
                        text: root.show-members ? "隐藏成员" : "显示成员";
                        clicked => { root.show-members = !root.show-members; }
                    }
                }

                ScrollView {
                    VerticalLayout {
                        padding-top: 10px; padding-bottom: 10px;
                        spacing: 0; alignment: start;
                        for msg in messages: MessageRow { msg: msg; }
                    }
                }
                // ---- sticker picker panel (M3): nine-grid above the input bar ----
                if root.show-stickers: Rectangle {
                    height: 224px;
                    background: Palette.side;
                    VerticalLayout { padding: 6px; spacing: 6px;
                        if root.pack-names.length > 1: HorizontalLayout {
                            spacing: 6px; alignment: start;
                            for pk[idx] in pack-names: Button {
                                text: root.current-pack == idx ? "■ " + pk : pk;
                                clicked => {
                                    root.current-pack = idx;
                                    root.select-pack(idx);
                                }
                            }
                        }
                        if root.sticker-cells.length == 0: Rectangle {
                            height: 160px; // VerticalLayout child needs a height
                            Text {
                                text: "没有表情包";
                                color: Palette.muted; font-size: 14px;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                        }
                        ScrollView {
                            Rectangle {
                                height: root.grid-height;
                                for cell in sticker-cells: Rectangle {
                                    x: cell.col * 72px; y: cell.row * 72px;
                                    width: 72px; height: 72px;
                                    // Keyboard access (a11y basics): Tab focuses a
                                    // cell, Enter sends it — same path as the click.
                                    cell-focus := FocusScope {
                                        key-pressed(event) => {
                                            if (event.text == Key.Return) {
                                                root.pick-sticker(cell.pack, cell.index);
                                                accept
                                            } else {
                                                reject
                                            }
                                        }
                                    }
                                    border-width: cell-focus.has-focus ? 2px : 0px;
                                    border-color: Palette.accent;
                                    TouchArea {
                                        clicked => { root.pick-sticker(cell.pack, cell.index); }
                                    }
                                    Image {
                                        x: 4px; y: 4px; width: 64px; height: 64px;
                                        image-fit: contain;
                                        source: cell.image;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px; background: Palette.header;
                }
                Rectangle {
                    height: 56px;
                    background: Palette.chat;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 10px; spacing: 8px;
                        LineEdit {
                            text <=> root.draft;
                            placeholder-text: "说点什么…";
                        }
                        Button {
                            text: "表情";
                            clicked => { root.show-stickers = !root.show-stickers; }
                        }
                        Button {
                            text: "发送";
                            clicked => { root.send(); }
                        }
                    }
                }
            }
        }

        // ---- collapsible member list ----
        if root.show-members: Rectangle {
            width: 240px;
            background: Palette.side;
            VerticalLayout { spacing: 0; alignment: start;
                Rectangle {
                    height: 48px;
                    Text {
                        text: "在线";
                        color: Palette.muted; font-size: 11px; font-weight: 700;
                        vertical-alignment: center; x: 16px;
                    }
                }
                for mbr in members: Rectangle {
                    height: 36px;
                    HorizontalLayout {
                        padding-left: 12px; spacing: 8px;
                        Rectangle {
                            width: 28px; height: 28px; border-radius: 14px;
                            background: Palette.avatars[Math.mod(mbr.color, 8)];
                            Text {
                                text: mbr.initial;
                                color: white; font-size: 13px; font-weight: 600;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        Text {
                            text: mbr.name;
                            color: Palette.text-secondary; font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
